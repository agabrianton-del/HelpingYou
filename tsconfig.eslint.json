{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "src",
    "__mocks__",
    "jest.config.js",
    "jest.setup.js",
    "jest.setup.frontend.js",
    "packages/*/src",
    "packages/*/test",
    "packages/*/__tests__"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
